# ==============================================================================
# Accounts Payable Automation Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security
# ------------------------------------------------------------------------------
PROJECT_NAME="Accounts Payable Automation Platform"
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/ap_automation"

# Option B: Individual PostgreSQL Parameters (Used if DATABASE_URL is not set)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="ap_automation"

# Note: If no PostgreSQL credentials or connection URI are provided, the backend
# safely defaults to SQLite ("sqlite:///./ap_automation.db") for zero-setup local trials.

# ------------------------------------------------------------------------------
# 3. Document Storage
# ------------------------------------------------------------------------------
STORAGE_DIR="backend/app/uploads"

# ------------------------------------------------------------------------------
# 4. OCR & Document Processing
# ------------------------------------------------------------------------------
OCR_PROVIDER="local"
# Set to custom Tesseract binary path if not on system PATH (e.g. Windows installer):
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# ------------------------------------------------------------------------------
# 5. Financial Validation & Matching Tolerances
# ------------------------------------------------------------------------------
AMOUNT_TOLERANCE=0.05
PRICE_VARIANCE_TOLERANCE_PCT=2.0
