# Accounts Payable Automation Platform - Environment Variables

# Application
PROJECT_NAME="Accounts Payable Automation Platform"
SECRET_KEY="enterprise_super_secret_jwt_key_ap_automation_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Production/Docker, SQLite default for zero-setup local dev)
DATABASE_URL="sqlite:///./ap_automation.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://ap_user:ap_password_2026@localhost:5432/ap_automation"

# Storage
STORAGE_DIR="backend/app/uploads"

# OCR & AI Extraction
OCR_PROVIDER="local"
TESSERACT_CMD=""

# Financial Tolerances
AMOUNT_TOLERANCE=0.05
PRICE_VARIANCE_TOLERANCE_PCT=2.0
